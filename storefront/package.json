{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:customer": "NEXT_PUBLIC_APP_PORTAL=customer next dev --turbopack -p 3000 -H 0.0.0.0",
    "dev:restaurant": "NEXT_PUBLIC_APP_PORTAL=restaurant next dev --turbopack -p 3001 -H 0.0.0.0",
    "dev:partner": "NEXT_PUBLIC_APP_PORTAL=partner next dev --turbopack -p 3002 -H 0.0.0.0",
    "dev:admin": "NEXT_PUBLIC_APP_PORTAL=admin next dev --turbopack -p 3003 -H 0.0.0.0",
    "build": "node build-prod.mjs",
    "build:customer": "NEXT_PUBLIC_APP_PORTAL=customer node build-prod.mjs",
    "build:restaurant": "NEXT_PUBLIC_APP_PORTAL=restaurant node build-prod.mjs",
    "build:partner": "NEXT_PUBLIC_APP_PORTAL=partner node build-prod.mjs",
    "build:admin": "NEXT_PUBLIC_APP_PORTAL=admin node build-prod.mjs",
    "start": "node start-prod.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "motion": "^14.9.0",
    "next": "15.5.28",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "15.5.28",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
