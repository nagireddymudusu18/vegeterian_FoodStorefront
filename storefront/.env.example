# Base URL of the edge proxy (Caddy) that routes /api/identity|catalog|orders|payments|fleet|notifications/*
# Inlined at build time (NEXT_PUBLIC_*): rebuild the storefront when it changes. For a sandbox deploy use
# https://<host> (see docs/getting-started.md).
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Public origin of the site, used for canonical links, the sitemap and Open Graph (default https://veggoeats.in).
# NEXT_PUBLIC_SITE_URL=https://veggoeats.in
# Search engines may index the site only when this is "true" (production). Leave it unset in the sandbox: every page
# then gets noindex and robots.txt disallows everything. Private areas (admin, cart, orders, ...) are never indexed.
# NEXT_PUBLIC_ALLOW_INDEXING=true
