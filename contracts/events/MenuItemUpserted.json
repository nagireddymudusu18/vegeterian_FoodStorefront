{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MenuItemUpserted",
  "description": "A menu item was created or changed. order-service keeps a replica to price orders.",
  "x-producer": "catalog-service",
  "x-consumers": ["order-service"],
  "type": "object",
  "additionalProperties": false,
  "required": ["itemId", "restaurantId", "name", "pricePaise", "isPureVeg", "isVegan", "isJain", "available"],
  "properties": {
    "itemId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "restaurantId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "name": { "type": "string", "minLength": 1 },
    "pricePaise": { "description": "Whole paise (INR x 100).", "type": "integer", "minimum": 0 },
    "isPureVeg": { "type": "boolean" },
    "isVegan": { "type": "boolean" },
    "isJain": { "type": "boolean" },
    "available": { "type": "boolean" }
  },
  "examples": [
    {
      "itemId": "33333333-3333-4333-8333-333333333333",
      "restaurantId": "11111111-1111-4111-8111-111111111111",
      "name": "Paneer Butter Masala",
      "pricePaise": 24900,
      "isPureVeg": true,
      "isVegan": false,
      "isJain": false,
      "available": true
    }
  ]
}
