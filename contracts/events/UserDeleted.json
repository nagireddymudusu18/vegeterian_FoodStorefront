{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserDeleted",
  "description": "An account was erased (DPDP). notification-service deletes the user's contacts and notifications.",
  "x-producer": "identity-service",
  "x-consumers": ["notification-service"],
  "type": "object",
  "additionalProperties": false,
  "required": ["userId"],
  "properties": {
    "userId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
  },
  "examples": [
    { "userId": "55555555-5555-4555-8555-555555555555" }
  ]
}
