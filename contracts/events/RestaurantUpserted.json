{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestaurantUpserted",
  "description": "A restaurant was created or changed. order-service keeps a replica of it.",
  "x-producer": "catalog-service",
  "x-consumers": ["order-service"],
  "type": "object",
  "additionalProperties": false,
  "required": ["restaurantId", "name", "lat", "lng", "open", "deliveryRadiusMeters", "kitchenCertificationLevel", "fssaiNumber", "ownerUserId"],
  "properties": {
    "restaurantId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "name": { "type": "string", "minLength": 1 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lng": { "type": "number", "minimum": -180, "maximum": 180 },
    "open": { "type": "boolean" },
    "deliveryRadiusMeters": { "type": "integer", "minimum": 0 },
    "kitchenCertificationLevel": { "type": "string", "enum": ["TIER_1_EXCLUSIVE_VEG", "TIER_2_SEGREGATED_KITCHEN"] },
    "fssaiNumber": { "type": ["string", "null"] },
    "ownerUserId": {
      "description": "The restaurant owner's user id (the JWT sub); null when no owner is linked yet.",
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  },
  "examples": [
    {
      "restaurantId": "11111111-1111-4111-8111-111111111111",
      "name": "Spice Route Kitchen",
      "lat": 12.9716,
      "lng": 77.5946,
      "open": true,
      "deliveryRadiusMeters": 5000,
      "kitchenCertificationLevel": "TIER_1_EXCLUSIVE_VEG",
      "fssaiNumber": "11223344556677",
      "ownerUserId": "22222222-2222-4222-8222-222222222222"
    }
  ]
}
