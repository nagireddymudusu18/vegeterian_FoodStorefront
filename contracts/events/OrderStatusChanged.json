{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderStatusChanged",
  "description": "An order moved from one status to another. fleet-service builds its delivery jobs from it, which is why orderNumber and restaurantName are included.",
  "x-producer": "order-service",
  "x-consumers": ["fleet-service"],
  "type": "object",
  "additionalProperties": false,
  "required": ["orderId", "customerId", "restaurantId", "from", "to", "totalPaise", "orderNumber"],
  "properties": {
    "orderId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "customerId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "restaurantId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "from": { "$ref": "#/$defs/status" },
    "to": { "$ref": "#/$defs/status" },
    "totalPaise": { "type": "integer", "minimum": 0 },
    "orderNumber": { "description": "The customer-facing order number, e.g. FA-ABCDE-12345.", "type": "string", "minLength": 1 },
    "restaurantName": { "description": "Present when the restaurant is known to order-service.", "type": "string" }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["CREATED", "PAID", "MERCHANT_ACCEPTED", "PREPARING", "RIDER_ASSIGNED", "PICKED_UP", "DELIVERED", "PAYMENT_FAILED", "CANCELLED", "REJECTED_BY_MERCHANT", "REFUNDED"]
    }
  },
  "examples": [
    {
      "orderId": "44444444-4444-4444-8444-444444444444",
      "customerId": "55555555-5555-4555-8555-555555555555",
      "restaurantId": "11111111-1111-4111-8111-111111111111",
      "from": "MERCHANT_ACCEPTED",
      "to": "PREPARING",
      "totalPaise": 72090,
      "orderNumber": "FA-ABCDE-12345",
      "restaurantName": "Spice Route Kitchen"
    }
  ]
}
