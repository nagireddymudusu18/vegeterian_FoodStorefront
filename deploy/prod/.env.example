# Copy to .env on the server (never commit .env). Generate secrets with: node ../scripts/gen-keys.mjs  (then copy the values)
GHCR_OWNER=nagireddymudusu18
TAG=latest
DOMAIN=veggoeats.in
ACME_EMAIL=you@veggoeats.in

# Leave DB_HOST=db for the bundled Postgres (--profile with-db); set the managed database host otherwise.
DB_HOST=db
DB_SUPERUSER_PASSWORD=
DB_PASSWORD_IDENTITY=
DB_PASSWORD_CATALOG=
DB_PASSWORD_ORDER=
DB_PASSWORD_PAYMENT=
DB_PASSWORD_FLEET=
DB_PASSWORD_NOTIFICATION=

JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
PII_ENC_KEY=
PII_HMAC_KEY=
# base64, 32 bytes; shared only by identity-service (encrypts) and notification-service (decrypts)
CONTACT_EVENT_KEY=
IDENTITY_FEED_KEY=
CATALOG_FEED_KEY=
ORDER_FEED_KEY=
PAYMENT_FEED_KEY=
FLEET_FEED_KEY=

# The one main admin (verified email and password sign-in only). They add other admins from /admin/team.
APP_MAIN_ADMIN_EMAIL=
SEED_DEMO_DATA=false

# logging = OTPs and email links are written to the log. Staging only.
SMS_PROVIDER=logging
EMAIL_PROVIDER=logging

# razorpay for real payments. Until Razorpay is approved, staging may use GATEWAY=fake together with
# ALLOW_FAKE_GATEWAY=true. The fake gateway marks every payment as paid without charging anyone, so
# never enable it where real customers can order; without ALLOW_FAKE_GATEWAY=true it refuses to start.
GATEWAY=razorpay
ALLOW_FAKE_GATEWAY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
