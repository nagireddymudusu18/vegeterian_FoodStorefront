NEXT_PUBLIC_API_BASE=

# Four-storefront portal isolation:
#   all        -> Dev/preview mode with Storefront Switcher Bar (default)
#   customer   -> Lock deployment exclusively to Customer Storefront
#   restaurant -> Lock deployment exclusively to Restaurant Partner App
#   partner    -> Lock deployment exclusively to Delivery Partner App
#   admin      -> Lock deployment exclusively to Org Admin Console
NEXT_PUBLIC_APP_PORTAL=all

# Optional production apex host locked automatically to the Customer Storefront (e.g. veggoeats.in)
NEXT_PUBLIC_CUSTOMER_HOST=

# Optional external cross-domain links (when set, Customer footer links out to separate partner domains)
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=
NEXT_PUBLIC_RESTAURANT_PORTAL_URL=
NEXT_PUBLIC_PARTNER_PORTAL_URL=
NEXT_PUBLIC_ADMIN_PORTAL_URL=